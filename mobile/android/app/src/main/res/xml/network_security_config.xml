<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <!-- Firebase, Stripe y APIs propias deben usar certificados de sistema confiables -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">roommatematch.com</domain>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
