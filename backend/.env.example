# Configuración de Stripe para RoomMate Match
# Copia este archivo a .env y rellena los valores reales

# Stripe Secret Key (nunca expongas en el cliente)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY

# Stripe Destination Bank Account (IBAN de tu cuenta bancaria verificada en Stripe)
STRIPE_DESTINATION_BANK_ACCOUNT=ES00XXXXXXXXXXXXXXXXXXXXXX

# Firebase / Backend
FIREBASE_PROJECT_ID=roommatematch-dev
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Webhook secret de Stripe (se obtiene al configurar el webhook en el Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=roommatematch

# Firebase / Backend
FIREBASE_PROJECT_ID=roommatematch-dev
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# URL base del backend (usada por el cliente Flutter en dev/prod)
BACKEND_BASE_URL=http://10.0.2.2:3000

# Puerto del servidor
PORT=3000

# Entorno (development | production)
NODE_ENV=development
