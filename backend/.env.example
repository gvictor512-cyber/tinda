# RoomMate Match - Environment Configuration
# Copy this file to .env and fill with real values.
# In production, load secrets from a vault or use Render's "sync: false" env vars.

# Stripe Secret Key (nunca expongas en el cliente)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY

# Stripe Destination Bank Account (IBAN de tu cuenta bancaria verificada en Stripe)
STRIPE_DESTINATION_BANK_ACCOUNT=ES00XXXXXXXXXXXXXXXXXXXXXX

# Firebase / Backend
FIREBASE_PROJECT_ID=roommatematch-dev
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Webhook secret de Stripe (se obtiene al configurar el webhook en el Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Database PostgreSQL
# Usa un rol NO superusuario (p. ej. app_user) para activar RLS.
DB_HOST=db
DB_PORT=5432
# DB_USERNAME=postgres  # Solo para crear tablas/migraciones la primera vez
DB_USERNAME=app_user
DB_PASSWORD=app_user_password
DB_DATABASE=roommatematch

# Variables para docker-compose
DB_SUPERUSER_PASSWORD=postgres
APP_USER_PASSWORD=app_user_password

# Firebase / Backend
FIREBASE_PROJECT_ID=roommatematch-dev
# Client email de la cuenta de servicio de Firebase (se encuentra en el json de la cuenta de servicio)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...-xxx@roommatematch-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# URL base del backend (usada por el cliente Flutter en dev/prod)
BACKEND_BASE_URL=http://10.0.2.2:3000

# Orígenes permitidos para CORS (separados por coma). En producción/staging pon el dominio exacto.
CORS_ORIGIN=http://localhost:3000

# Puerto del servidor
PORT=3000

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:3000

# JWT secret (min 32 chars, used by @nestjs/jwt)
JWT_SECRET=change_this_to_a_very_long_random_string_32chars

# Entorno (development | production)
# En producción/staging Swagger se deshabilita automáticamente.
NODE_ENV=development

# Optional: Redis URL for distributed caching / WebSockets
# REDIS_URL=redis://localhost:6379

# Email transaccional (facturas de compra) via API de Resend.
# Obtén una API key en https://resend.com y verifica tu dominio.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# Remitente verificado en Resend (debe pertenecer a tu dominio verificado).
# En pruebas puedes usar: RoomMate Match <onboarding@resend.dev>
MAIL_FROM=RoomMate Match <facturas@roommatematchapp.com>
